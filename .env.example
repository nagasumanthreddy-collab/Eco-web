# DATABASE_URL: SQLite database file path for Prisma
DATABASE_URL="file:./dev.db"

# JWT_SECRET: Secret key used to sign httpOnly authentication cookies
JWT_SECRET="ecopredict-dev-secret-change-in-production"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY=""
